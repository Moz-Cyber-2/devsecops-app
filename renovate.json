{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchConfidence": ["high", "very high"],
      "groupName": "non-major dependencies (high confidence)",
      "automerge": false
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchConfidence": ["low", "neutral", "unknown"],
      "groupName": "non-major dependencies (low confidence)",
      "automerge": false
    },
    {
      "matchUpdateTypes": ["major"],
      "groupName": "all major dependencies",
      "automerge": false
    }
  ]
}
